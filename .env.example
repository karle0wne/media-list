# Optional application-native runtime config. Production may mount a JSON file at
# /config/application.json; set this only to use another path. Non-secret runtime
# settings can live there; environment values remain explicit local overrides and
# the channel for secrets.
MEDIA_LIST_CONFIG_FILE=

# Persistent SQLite file. May instead be set as application.json databasePath.
DATABASE_PATH=./data/media-list.db

# Optional. One server-side TMDB API Read Access Token for this installation.
TMDB_API_TOKEN=
# These tuning values may instead live under application.json tmdb.
TMDB_METADATA_TTL_DAYS=30
TMDB_REFRESH_LIMIT=50

# Optional. Enables the Games category through RAWG. RAWG requires attribution
# on pages where its data or images are displayed.
RAWG_API_KEY=

# media-list does not authenticate users. Production must expose it only through
# the trusted auth gateway, which injects X-Auth-Subject, X-Auth-Email and
# X-Auth-Name after access has been validated.

# Compose host binding. Production reverse proxies bind the app to loopback.
APP_BIND=0.0.0.0
APP_PORT=3000
APP_REVISION=dev

# Optional S3-compatible backup target (Cloudflare R2 works here).
# endpoint/region/bucket/prefix may live under application.json backup.s3;
# only the access key and secret key are credentials and should remain secret env.
# The application keeps one current recovery object at
# <S3_PREFIX>latest/media-list.db.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=media-list/
