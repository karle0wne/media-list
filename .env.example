# Persistent SQLite file. Docker Compose mounts ./data to /data.
DATABASE_PATH=./data/media-list.db

# Optional. One server-side TMDB API Read Access Token for this installation.
TMDB_API_TOKEN=
TMDB_METADATA_TTL_DAYS=30
TMDB_REFRESH_LIMIT=50

# Optional. Enables the Games category through RAWG. RAWG requires attribution
# on pages where its data or images are displayed.
RAWG_API_KEY=

# Invite-only capacity guard. Admin accounts count toward the limit.
MAX_USERS=5

# Session cookie security. Production behind HTTPS must use true.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# Canonical public URL used for auth callbacks and legacy invite/reset/magic-login links.
APP_BASE_URL=http://127.0.0.1:3000

# Transitional centralized IAM/SSO. When all values are present, /login offers
# OIDC sign-in. During migration, the verified IAM email must already belong to
# an active local user; the stable OIDC subject is then bound to that user.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ADMIN_ROLE=media-list:admin
OIDC_USER_ROLE=media-list:user

# Legacy passwordless email sign-in retained only as a migration fallback.
# MAGIC_LINK_FROM must be a sender registered and verified in Brevo.
BREVO_API_KEY=
MAGIC_LINK_FROM=

# Compose host binding. Production reverse proxies should bind the app to loopback.
APP_BIND=0.0.0.0
APP_PORT=3000
APP_REVISION=dev

# Optional S3-compatible backup target (Cloudflare R2 works here).
# The application keeps one current recovery object at
# <S3_PREFIX>latest/media-list.db.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=media-list/
