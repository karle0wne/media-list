# Optional application-native runtime config. Production may mount a JSON file at
# /config/application.json; set this only to use another path. Non-secret runtime
# settings can live there; environment values remain explicit local overrides and
# the channel for secrets.
MEDIA_LIST_CONFIG_FILE=

# Persistent SQLite file. May instead be set as application.json databasePath.
DATABASE_PATH=./data/media-list.db

# Optional. One server-side TMDB API Read Access Token for this installation.
TMDB_API_TOKEN=
# These tuning values may instead live under application.json tmdb.
TMDB_METADATA_TTL_DAYS=30
TMDB_REFRESH_LIMIT=50

# Optional. Enables the Games category through RAWG. RAWG requires attribution
# on pages where its data or images are displayed.
RAWG_API_KEY=

# media-list does not authenticate users. Production must expose it only through
# the trusted auth gateway, which injects X-Auth-Subject, X-Auth-Email and
# X-Auth-Name after access has been validated.
#
# Shared secret between that gateway and this service. The gateway sends it as the
# X-Gateway-Secret header on every request it forwards and drops any copy a client sends;
# a request without it is refused with 401, so spoofed X-Auth-* headers are useless even
# if the service is reached by another route. Required in production (at least 32
# characters, the server refuses to start without it). Generate one with:
#   openssl rand -hex 32
GATEWAY_SHARED_SECRET=
# Only for an installation where the network alone keeps everything but the gateway away
# from this service. Trusts X-Auth-* headers without a secret and logs a warning.
# ALLOW_UNSIGNED_GATEWAY_HEADERS=true

# How often (seconds) the server finishes metadata enrichment that a restart or a provider
# rate limit interrupted. Page views never trigger provider calls.
ENRICHMENT_RECOVERY_INTERVAL_SECONDS=60

# Optional. Secret that signs search results so the "Add" button can save them without
# asking the provider again. Without it a random per-process secret is used, which means
# search pages opened before a restart must be searched again.
CANDIDATE_TOKEN_SECRET=

# Compose host binding. The app has no login of its own, so it listens on loopback
# by default and must only be reached through the trusted auth gateway. Set another
# address only when the gateway runs on a different host.
APP_BIND=127.0.0.1
APP_PORT=3000
APP_REVISION=dev

# Optional S3-compatible backup target (Cloudflare R2 works here).
# endpoint/region/bucket/prefix may live under application.json backup.s3;
# only the access key and secret key are credentials and should remain secret env.
# Each backup writes a dated version to <S3_PREFIX>history/ and updates the recovery
# object <S3_PREFIX>latest/media-list.db. The newest BACKUP_KEEP_VERSIONS versions are
# kept (may also live under application.json backup.keepVersions).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=media-list/
BACKUP_KEEP_VERSIONS=30
