# Persistent SQLite file. Docker Compose mounts ./data to /data.
DATABASE_PATH=./data/media-list.db

# Optional. TMDB is needed for movie/series search and validation.
TMDB_API_TOKEN=

# Invite-only capacity guard. Admin accounts count toward the limit.
MAX_USERS=5

# Session cookie security. Set true behind HTTPS; leave false for plain IP:port HTTP.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# Optional canonical public URL used when displaying invite links.
APP_BASE_URL=http://127.0.0.1:3000

# Optional S3-compatible backups (Cloudflare R2 works here).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=media-list/
