{
  "name": "media-list",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "ui:fixture": "tsx scripts/ui-fixture.ts",
    "ui:proof": "playwright test --config=playwright.config.ts",
    "providers:smoke": "tsx scripts/provider-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "restore:local": "tsx scripts/restore-local.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "metadata:refresh": "tsx scripts/refresh-metadata.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
